WORKING_DIR=/workspace
SPLENT_APP=diversolab_app
PYTHONPATH=/workspace/diversolab_app/src
FLASK_APP=diversolab_app:create_app

# Signs sessions, CSRF tokens and every link the app has to trust (password
# resets). product:deploy generates a random one when it finds <SET>; on a
# host without the CLI use: python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
SECRET_KEY=<SET>

MARIADB_HOSTNAME=diversolab_app_db_deploy
MARIADB_DATABASE=<SET>
MARIADB_USER=<SET>
MARIADB_PASSWORD=<SET>
MARIADB_ROOT_PASSWORD=<SET>

RUN_DB_SEED=false

# Host interfaces for the ports published by docker-compose.prod.yml.
# 127.0.0.1 keeps them reachable only from the host itself, the right setup
# when a proxy on the host terminates TLS and forwards to loopback. Set a
# variable to 0.0.0.0, or delete its line, to publish on all interfaces.
# user-tunable
SPLENT_WEB_BIND_HOST=127.0.0.1
# user-tunable
SPLENT_DB_BIND_HOST=127.0.0.1

# Persistent data directories inside the web container. They are the mount
# targets of the named volumes declared in docker-compose.prod.yml, so their
# contents survive redeploys. PROTECTED_UPLOADS_DIR holds uploads served
# through the app (outside static/), ARCHIVE_DIR holds extra static content.
# Change a path only together with the matching volume in the compose file.
# user-tunable
PROTECTED_UPLOADS_DIR=/workspace/diversolab_app/protected_uploads
# user-tunable
ARCHIVE_DIR=/workspace/diversolab_app/archive

# diversolab.us.es sits behind the university front (diverso.lsi.us.es),
# which terminates TLS and forwards plain HTTP to this host. The nginx of the
# product is the only published entry point, on the port the front expects.
# Only that front may assert X-Forwarded-* headers, so its address goes in
# NGINX_TRUSTED_PROXY_CIDRS (asked for on deploy).
NGINX_SERVER_NAME=diversolab.us.es
# user-tunable
NGINX_HTTP_HOST_PORT=80
# user-tunable
NGINX_HTTPS_HOST_PORT=8444
NGINX_TRUSTED_PROXY_CIDRS=<SET>

# Redis has no business on a public interface; loopback only.
# user-tunable
REDIS_HOST_PORT=127.0.0.1:6505

# Outgoing mail for the contact and careers forms.
MAIL_HOST=<SET>
# user-tunable
MAIL_PORT=587
# user-tunable
MAIL_USE_TLS=1
MAIL_USERNAME=<SET>
MAIL_PASSWORD=<SET>
MAIL_FROM=<SET>

# Cloudflare Turnstile keys issued for the diversolab.us.es hostname.
TURNSTILE_SITE_KEY=<SET>
TURNSTILE_SECRET_KEY=<SET>
